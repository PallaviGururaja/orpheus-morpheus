# ============================================================================
# Local Data-Analysis Agent — environment (fully on-device, nothing leaves the box)
# Copy to .env and fill in. All keys use the AGENT_ prefix.
# ============================================================================

# --- Storage: local PostgreSQL (app history / audit trail only; datasets live on disk) ---
AGENT_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/data_analyst

# --- LLM: fully local via Ollama (OpenAI-compatible endpoint; no cloud, no API key) ---
AGENT_LLM_PROVIDER=ollama
AGENT_LLM_BASE_URL=http://localhost:11434/v1
AGENT_LLM_MODEL=qwen2.5-coder:7b

# Cloud provider keys are intentionally unused (provider is pinned to ollama above).
AGENT_ANTHROPIC_API_KEY=
AGENT_GEMINI_API_KEY=

PORT=8001
